<?xml version="1.0" ?>
<sdf version="1.4">
 <world name="default">
    <physics type="ode">
      <gravity>0 0 0</gravity>
      <real_time_update_rate>0</real_time_update_rate>
      <max_step_size> 0.001</max_step_size>
      <ode>
        <solver>
            <type>quick</type>
            <iters>100</iters>
        </solver>
        <constraints>
            <cfm>0.0001</cfm>
            <erp>0.1</erp>
            <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
        </constraints>
      </ode>
    </physics>
  </world>
</sdf>
