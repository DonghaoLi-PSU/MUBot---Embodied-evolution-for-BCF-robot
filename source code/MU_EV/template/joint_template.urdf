<?xml version="1.0" encoding="utf-8"?>
<robot  name="mubot">

<joint name="base_act1" type="revolute">
  <origin xyz="1.1 0 0" rpy="0 0 0" />
  <parent link="segment_head" />
  <child  link="act1" />
  <axis  xyz="0 0 1" />
  <limit
    lower="-1.57"
    upper="1.57"
    effort="10"
    velocity="10" />
  <dynamics damping="0.01" friction="0.0"/>
</joint>

<gazebo reference="joint_name">
  <dynamics>
    <springStiffness>50.0</springStiffness>
    <springReference>0.0</springReference>
  </dynamics>
  <implicitSpringDamper>true</implicitSpringDamper>
</gazebo>


</robot>
