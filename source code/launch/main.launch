<?xml version="1.0" encoding="UTF-8"?>
<launch>

    <env name="ROSCONSOLE_CONFIG_FILE" value="$(find des_mubot)/config/rosconsole.config"/>
    <arg name="debug" default="false"/>
    <arg name="gui" default="false"/>
    <arg name="headless" default="true"/>
    <arg name="pause" default="true"/>
    <param name="/use_sim_time" value="true" />
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find des_mubot)/worlds/mubot.world"/>
        <arg name="debug" value="$(arg debug)" />
        <arg name="gui" value="false" />
        <arg name="paused" value="$(arg pause)"/>
        <arg name="verbose" value="false"/>
        <!-- <arg name="use_sim_time" value="true"/> -->
        <arg name="headless" value="true"/>
        <env name="LIBGL_ALWAYS_SOFTWARE" value="1"/>
        <env name="GAZEBO_MODEL_PATH" value="$(find des_mubot)/models:$(optenv GAZEBO_MODEL_PATH)"/>
        <env name="ROSCONSOLE_CONFIG_FILE" value="$(find des_mubot)/config/rosconsole.config"/>
    </include>
    <param name="/gazebo/enable_ros_network" value="true"/>

    <arg name="x" default="0.0" />
    <arg name="y" default="0.0" />
    <arg name="z" default="0.0" />
    <arg name="roll" default="0.0"/>
    <arg name="pitch" default="0.0"/>
    <arg name="yaw" default="0.0"/>
    <arg name="urdf_robot_file" default="$(find des_mubot)/Database/1/mubot.urdf"/>
    <arg name="robot_name" default="mubot_1" />

    <param name="robot_description" command="cat $(arg urdf_robot_file)" />
    <node name="$(arg robot_name)_urdf_spawner" pkg="gazebo_ros" type="spawn_model" respawn="false" 
    output="log" launch-prefix="$(find des_mubot)/config/silent_spawn.sh"
    args="-urdf -x $(arg x) -y $(arg y) -z $(arg z) -R $(arg roll) -P $(arg pitch) -Y $(arg yaw) -model $(arg robot_name) -param robot_description"/>

</launch>
