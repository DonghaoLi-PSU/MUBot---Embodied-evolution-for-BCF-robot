<?xml version="1.0" encoding="utf-8"?>
<robot
  name="mubot">

<link name="head">
  <inertial>
    <origin
      xyz="0.0 0.0 0.0"
      rpy="0 0 0" />
    <mass
      value="1" />
    <inertia
      ixx="1"
      ixy="0.0"
      ixz="0.0"
      iyy="1"
      iyz="0.0"
      izz="1" />
  </inertial>
  <visual>
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <geometry>
      <box size="2 2 10"/>
    </geometry>
  </visual>
  <collision>
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <geometry>
      <box size="2 2 10"/>
    </geometry>
  </collision>
</link>


<gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
        <robotNamespace>/mubot</robotNamespace>
    </plugin>
</gazebo>


<gazebo>
     <plugin name="Actuator_control" filename="libactuator_plugin.so"/>
     <plugin name="Hydro_Plugin" filename="libHydro_plugin.so"/>
</gazebo>

</robot>
